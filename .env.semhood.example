# ==============================================================================
# semhood — example environment file
# ==============================================================================
# Copy to `.env.semhood` and fill in real values. The real file is git-ignored.

# --- LLM providers (set whichever you use; leave others blank) ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
GOOGLE_API_KEY=

# --- Embeddings ---
VOYAGE_API_KEY=pa-...
COHERE_API_KEY=

# --- Qdrant (local on-disk by default; uncomment URL for remote) ---
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=semhood
QDRANT_VECTOR_DIM=768

# --- Optional model overrides ---
SEMHOOD_ANTHROPIC_MODEL=claude-sonnet-4-20250514
SEMHOOD_VOYAGE_MODEL=voyage-code-2
SEMHOOD_VOYAGE_BATCH_SIZE=128
